# --- Required ---
DATABASE_URL="postgresql://user:password@host:5432/evotasks"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://tasks.evolutiongolf.co.uk"
CRON_SECRET="generate-with: openssl rand -base64 32"
APP_TIMEZONE="Europe/London"

# --- Slack, optional. The app runs fully without these. ---
# Outbound nudges need the bot token. Inbound (DMs and Done buttons) also needs
# the signing secret — without it every inbound request is refused, which is the
# correct default for a public endpoint.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_MANAGER_CHANNEL_ID=

# --- Free-text Slack replies, optional. Buttons work without it. ---
ANTHROPIC_API_KEY=

# --- Seed only, optional. Defaults to "ChangeMe123!" ---
SEED_DEFAULT_PASSWORD=
