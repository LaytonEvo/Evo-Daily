// EvoTasks — recurring operational accountability for Evolution Golf.
//
// Multi-tenancy note: every table carries organisationId from day one, but v1
// ships with a single seeded organisation and no org-switching UI. This is a
// deliberate cheap hedge against pointing the same tool at another business.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Europe/London")
  createdAt DateTime @default(now())

  users       User[]
  absences    Absence[]
  categories  Category[]
  templates   TaskTemplate[]
  instances   TaskInstance[]
  settings    Settings?
  comments    Comment[]
  attachments Attachment[]
}

model User {
  id                 String   @id @default(cuid())
  organisationId     String
  email              String   @unique
  name               String
  passwordHash       String
  role               Role     @default(MEMBER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  slackUserId        String? // optional, for Phase 3 nudges
  managerId          String? // optional, for Phase 3 miss alerts
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation       Organisation   @relation(fields: [organisationId], references: [id])
  manager            User?          @relation("ManagerReports", fields: [managerId], references: [id])
  reports            User[]         @relation("ManagerReports")
  assignedTemplates  TaskTemplate[] @relation("TemplateAssignee")
  createdTemplates   TaskTemplate[] @relation("TemplateCreator")
  assignedInstances  TaskInstance[] @relation("InstanceAssignee")
  completedInstances TaskInstance[] @relation("InstanceCompleter")
  auditLogs          AuditLog[]
  comments           Comment[]
  attachments        Attachment[]
  absences           Absence[]      @relation("AbsenceUser")
  covering           Absence[]      @relation("AbsenceCover")
  bookedAbsences     Absence[]      @relation("AbsenceCreator")

  @@index([organisationId, isActive])
}

enum Role {
  ADMIN
  MEMBER
}

model Category {
  id             String  @id @default(cuid())
  organisationId String
  name           String // e.g. "Customer Support", "Stock", "Marketing"
  colour         String // hex
  sortOrder      Int     @default(0)
  // Retired rather than deleted once anything references it, so historical
  // reports still resolve the name they were recorded under.
  isActive       Boolean @default(true)

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  templates    TaskTemplate[]
  instances    TaskInstance[]

  @@unique([organisationId, name])
  @@index([organisationId, sortOrder])
}

model TaskTemplate {
  id             String    @id @default(cuid())
  organisationId String
  title          String
  description    String? // short. plain text or basic markdown. not a wiki.
  categoryId     String?
  assigneeId     String // one assignee. no multi-assign in v1.
  frequency      Frequency
  daysOfWeek     Int[] // DAILY only. 1=Mon..7=Sun. default [1,2,3,4,5]
  dayOfWeek      Int? // WEEKLY only. 1=Mon..7=Sun
  dayOfMonth     Int? // MONTHLY only. 1..31, clamped to month length
  dueTime        String? // optional "HH:mm" cut-off within the due date
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  isActive       Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  category     Category?      @relation(fields: [categoryId], references: [id])
  assignee     User           @relation("TemplateAssignee", fields: [assigneeId], references: [id])
  createdBy    User           @relation("TemplateCreator", fields: [createdById], references: [id])
  instances    TaskInstance[]

  @@index([organisationId, isActive])
  @@index([assigneeId])
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  ONE_OFF
}

model TaskInstance {
  id             String    @id @default(cuid())
  organisationId String
  templateId     String
  dueDate        DateTime  @db.Date
  dueAt          DateTime? // computed from dueDate + template.dueTime, in London

  // --- snapshot fields, frozen at generation time ---
  title      String
  assigneeId String
  categoryId String?
  // ---

  status        InstanceStatus @default(PENDING)
  completedAt   DateTime?
  completedById String?
  wasLate       Boolean        @default(false)
  note          String? // optional free-text on completion
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  template     TaskTemplate @relation(fields: [templateId], references: [id])
  assignee     User         @relation("InstanceAssignee", fields: [assigneeId], references: [id])
  completedBy  User?        @relation("InstanceCompleter", fields: [completedById], references: [id])
  category     Category?    @relation(fields: [categoryId], references: [id])
  auditLogs    AuditLog[]
  comments     Comment[]

  @@unique([templateId, dueDate]) // idempotency guarantee — critical
  @@index([assigneeId, dueDate])
  @@index([organisationId, dueDate, status])
}

enum InstanceStatus {
  PENDING
  COMPLETED
  MISSED
  /// Nobody was expected to do this — the assignee was away and it was not
  /// covered. Counted in neither the numerator nor the denominator of a
  /// completion rate, so time off does not read as poor performance.
  EXCUSED
}

// Every status change writes exactly one row here. The reporting is only
// credible if it is auditable.
model AuditLog {
  id             String         @id @default(cuid())
  organisationId String
  instanceId     String
  userId         String? // null for system transitions (the nightly sweep)
  fromStatus     InstanceStatus
  toStatus       InstanceStatus
  source         AuditSource    @default(USER)
  at             DateTime       @default(now())

  instance TaskInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user     User?        @relation(fields: [userId], references: [id])

  @@index([instanceId, at])
  @@index([organisationId, at])
}

enum AuditSource {
  USER
  SYSTEM
}

// Single row per organisation.
model Settings {
  organisationId        String @id
  graceDays             Int    @default(2)
  generationHorizonDays Int    @default(14)

  organisation Organisation @relation(fields: [organisationId], references: [id])
}

/// A comment on one dated occurrence of a task, not on the recurring rule.
/// The rule is a template and lives forever; what went wrong on Tuesday
/// belongs to Tuesday.
model Comment {
  id             String   @id @default(cuid())
  organisationId String
  instanceId     String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  instance     TaskInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])
  attachments  Attachment[]

  @@index([instanceId, createdAt])
}

/// A file on a comment. The bytes live in object storage; this row is the
/// record of them, so a listing never has to touch the bucket.
///
/// `storageKey` is written by the server, never supplied by the client — a
/// client-chosen key is a path-traversal hole and a way to read someone
/// else's file.
model Attachment {
  id             String   @id @default(cuid())
  organisationId String
  commentId      String
  storageKey     String   @unique
  filename       String
  contentType    String
  bytes          Int
  uploadedById   String
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  comment      Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([commentId])
}

/// A period when someone is not working.
///
/// Both dates are inclusive and stored as plain dates, like every other date
/// in this app — a holiday is a set of days, not an instant, and the London
/// conversion belongs in lib/time.
///
/// With a cover person, that period's tasks are reassigned to them and count
/// against them as normal. Without one, the tasks become EXCUSED: still on the
/// record, so you can see what went uncovered, but out of the completion rate.
model Absence {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  from           DateTime @db.Date
  to             DateTime @db.Date
  /// Free text: "Annual leave", "Sick", "Course". Not an enum — the reasons a
  /// person is away are not a fixed list and nothing branches on this.
  reason         String?
  /// Null means the work is excused rather than covered.
  coverUserId    String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation("AbsenceUser", fields: [userId], references: [id])
  cover        User?        @relation("AbsenceCover", fields: [coverUserId], references: [id])
  createdBy    User         @relation("AbsenceCreator", fields: [createdById], references: [id])

  @@index([organisationId, from, to])
  @@index([userId, from, to])
}
