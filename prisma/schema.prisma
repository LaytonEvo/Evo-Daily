// EvoTasks — recurring operational accountability for Evolution Golf.
//
// Multi-tenancy note: every table carries organisationId from day one, but v1
// ships with a single seeded organisation and no org-switching UI. This is a
// deliberate cheap hedge against pointing the same tool at another business.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Europe/London")
  createdAt DateTime @default(now())

  users       User[]
  absences    Absence[]
  categories  Category[]
  templates   TaskTemplate[]
  instances   TaskInstance[]
  settings    Settings?
  comments    Comment[]
  attachments Attachment[]
  signIns     SignIn[]
}

model User {
  id                 String   @id @default(cuid())
  organisationId     String
  email              String   @unique
  name               String
  passwordHash       String
  role               Role     @default(MEMBER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  slackUserId        String? // optional, for Phase 3 nudges
  managerId          String? // optional, for Phase 3 miss alerts
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation       Organisation   @relation(fields: [organisationId], references: [id])
  manager            User?          @relation("ManagerReports", fields: [managerId], references: [id])
  reports            User[]         @relation("ManagerReports")
  assignedTemplates  TaskTemplate[] @relation("TemplateAssignee")
  createdTemplates   TaskTemplate[] @relation("TemplateCreator")
  assignedInstances  TaskInstance[] @relation("InstanceAssignee")
  completedInstances TaskInstance[] @relation("InstanceCompleter")
  auditLogs          AuditLog[]
  comments           Comment[]
  attachments        Attachment[]
  absences           Absence[]      @relation("AbsenceUser")
  covering           Absence[]      @relation("AbsenceCover")
  coveringTasks      AbsenceCover[] @relation("AbsenceCoverPerTask")
  bookedAbsences     Absence[]      @relation("AbsenceCreator")
  signIns            SignIn[]
  commentReads       CommentRead[]
  activity           DailyActivity[]
  /**
   * The last time they loaded a page, not the last time they signed in. The
   * session cookie lasts a month, so a sign-in says when somebody first typed
   * a password and nothing at all about whether they have opened it since.
   */
  lastActiveAt       DateTime?

  @@index([organisationId, isActive])
}

enum Role {
  ADMIN
  MEMBER
}

model Category {
  id             String  @id @default(cuid())
  organisationId String
  name           String // e.g. "Customer Support", "Stock", "Marketing"
  colour         String // hex
  sortOrder      Int     @default(0)
  // Retired rather than deleted once anything references it, so historical
  // reports still resolve the name they were recorded under.
  isActive       Boolean @default(true)

  organisation  Organisation   @relation(fields: [organisationId], references: [id])
  templates     TaskTemplate[]
  instances     TaskInstance[]
  absenceCovers AbsenceCover[]

  @@unique([organisationId, name])
  @@index([organisationId, sortOrder])
}

model TaskTemplate {
  id             String    @id @default(cuid())
  organisationId String
  title          String
  description    String? // short. plain text or basic markdown. not a wiki.
  categoryId     String?
  assigneeId     String // one assignee. no multi-assign in v1.
  frequency      Frequency
  daysOfWeek     Int[] // DAILY only. 1=Mon..7=Sun. default [1,2,3,4,5]
  dayOfWeek      Int? // WEEKLY only. 1=Mon..7=Sun
  dayOfMonth     Int? // MONTHLY only. 1..31, clamped to month length
  dueTime        String? // optional "HH:mm" cut-off within the due date
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  isActive       Boolean   @default(true)
  // Sorts to the top of the owner's day, above the clock. Read live from the
  // template rather than frozen onto each instance: starring a task is a
  // statement about what matters now, so it has to land on today's list.
  isStarred      Boolean   @default(false)
  // How many days before it is due this appears on the owner's day. Null means
  // "whatever suits this frequency" — see DEFAULT_LEAD_DAYS. Explicitly 0 means
  // no warning at all, which is right for a daily task and wrong for a monthly
  // one that lands at midnight and is missed by the next.
  leadDays       Int?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation  Organisation   @relation(fields: [organisationId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  assignee      User           @relation("TemplateAssignee", fields: [assigneeId], references: [id])
  createdBy     User           @relation("TemplateCreator", fields: [createdById], references: [id])
  instances     TaskInstance[]
  absenceCovers AbsenceCover[]

  @@index([organisationId, isActive])
  @@index([assigneeId])
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  ONE_OFF
}

model TaskInstance {
  id             String    @id @default(cuid())
  organisationId String
  templateId     String
  dueDate        DateTime  @db.Date
  dueAt          DateTime? // computed from dueDate + template.dueTime, in London

  // --- snapshot fields, frozen at generation time ---
  title      String
  assigneeId String
  categoryId String?
  // ---

  status        InstanceStatus @default(PENDING)
  completedAt   DateTime?
  completedById String?
  wasLate       Boolean        @default(false)
  note          String? // optional free-text on completion
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  template     TaskTemplate @relation(fields: [templateId], references: [id])
  assignee     User         @relation("InstanceAssignee", fields: [assigneeId], references: [id])
  completedBy  User?        @relation("InstanceCompleter", fields: [completedById], references: [id])
  category     Category?    @relation(fields: [categoryId], references: [id])
  auditLogs    AuditLog[]
  comments     Comment[]
  reads        CommentRead[]

  @@unique([templateId, dueDate]) // idempotency guarantee — critical
  @@index([assigneeId, dueDate])
  @@index([organisationId, dueDate, status])
}

enum InstanceStatus {
  PENDING
  COMPLETED
  MISSED
  /// Nobody was expected to do this — the assignee was away and it was not
  /// covered. Counted in neither the numerator nor the denominator of a
  /// completion rate, so time off does not read as poor performance.
  EXCUSED
}

// Every status change writes exactly one row here. The reporting is only
// credible if it is auditable.
model AuditLog {
  id             String         @id @default(cuid())
  organisationId String
  instanceId     String
  userId         String? // null for system transitions (the nightly sweep)
  fromStatus     InstanceStatus
  toStatus       InstanceStatus
  source         AuditSource    @default(USER)
  at             DateTime       @default(now())

  instance TaskInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user     User?        @relation(fields: [userId], references: [id])

  @@index([instanceId, at])
  @@index([organisationId, at])
}

enum AuditSource {
  USER
  SYSTEM
}

// Single row per organisation.
model Settings {
  organisationId        String @id
  graceDays             Int    @default(2)
  generationHorizonDays Int    @default(14)

  organisation Organisation @relation(fields: [organisationId], references: [id])
}

/// A comment on one dated occurrence of a task, not on the recurring rule.
/// The rule is a template and lives forever; what went wrong on Tuesday
/// belongs to Tuesday.
/**
 * How far somebody has read one task's thread.
 *
 * One row per person per thread rather than a single "messages last opened"
 * stamp on the user: with one stamp, opening the list to read one reply marks
 * every other thread read too, and an unread count that lies once is one
 * nobody trusts again.
 */
model CommentRead {
  userId     String
  instanceId String
  readAt     DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance TaskInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@id([userId, instanceId])
  @@index([userId])
}

/**
 * One row per person per day they used it.
 *
 * Rolled up rather than a row per page load: the question is "are they opening
 * this", which a day answers and a hundred rows of page views answers worse
 * and forever. `visits` counts active spells rather than requests — it is
 * written at most once every couple of minutes, so a tab left open all
 * afternoon does not read as heavy use.
 */
model DailyActivity {
  userId String
  day    DateTime @db.Date
  visits Int      @default(1)
  lastAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

model Comment {
  id             String   @id @default(cuid())
  organisationId String
  instanceId     String
  authorId       String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  instance     TaskInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])
  attachments  Attachment[]

  @@index([instanceId, createdAt])
}

/// A file on a comment. The bytes live in object storage; this row is the
/// record of them, so a listing never has to touch the bucket.
///
/// `storageKey` is written by the server, never supplied by the client — a
/// client-chosen key is a path-traversal hole and a way to read someone
/// else's file.
model Attachment {
  id             String   @id @default(cuid())
  organisationId String
  commentId      String
  storageKey     String   @unique
  filename       String
  contentType    String
  bytes          Int
  uploadedById   String
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  comment      Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([commentId])
}

/// A period when someone is not working.
///
/// Both dates are inclusive and stored as plain dates, like every other date
/// in this app — a holiday is a set of days, not an instant, and the London
/// conversion belongs in lib/time.
///
/// With a cover person, that period's tasks are reassigned to them and count
/// against them as normal. Without one, the tasks become EXCUSED: still on the
/// record, so you can see what went uncovered, but out of the completion rate.
model Absence {
  id             String   @id @default(cuid())
  organisationId String
  userId         String
  from           DateTime @db.Date
  to             DateTime @db.Date
  /// Free text: "Annual leave", "Sick", "Course". Not an enum — the reasons a
  /// person is away are not a fixed list and nothing branches on this.
  reason         String?
  /// The default for every task in the period. Null excuses them. Individual
  /// tasks can override this with an AbsenceCover row.
  coverUserId    String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation   @relation(fields: [organisationId], references: [id])
  user         User           @relation("AbsenceUser", fields: [userId], references: [id])
  cover        User?          @relation("AbsenceCover", fields: [coverUserId], references: [id])
  createdBy    User           @relation("AbsenceCreator", fields: [createdById], references: [id])
  covers       AbsenceCover[]

  @@index([organisationId, from, to])
  @@index([userId, from, to])
}

/// Per-task cover for one absence, overriding the absence's default.
///
/// A row with no coverUserId is not redundant: it is how one task gets excused
/// while the rest of the period is covered by someone.
model AbsenceCover {
  id          String  @id @default(cuid())
  absenceId   String
  templateId  String
  /// Null means this particular task is excused rather than covered.
  coverUserId String?

  absence    Absence      @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  template   TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  cover      User?        @relation("AbsenceCoverPerTask", fields: [coverUserId], references: [id])
  category   Category?    @relation(fields: [categoryId], references: [id])
  categoryId String?

  @@unique([absenceId, templateId])
  @@index([templateId])
}

/// Why a sign-in attempt ended the way it did. Only the outcomes an admin can
/// do something about: reset a password, or turn an account back on.
enum SignInOutcome {
  SUCCESS
  WRONG_PASSWORD
  DEACTIVATED
}

/// One attempt to sign in to a known account.
///
/// Answers the question a completion rate cannot: is this person using the
/// platform at all? A member who never signs in and a member who signs in and
/// ignores their list look identical on the reports and need opposite
/// conversations.
///
/// Deliberately no IP address and no user agent. The question is whether
/// somebody is using EvoTasks, not where they were sitting, and a field that
/// exists gets used for things it was not collected for.
///
/// An attempt against an email with no account is not recorded: there is
/// nobody to attribute it to, and storing whatever an anonymous visitor typed
/// into a login box is a liability rather than an audit trail.
model SignIn {
  id             String        @id @default(cuid())
  organisationId String
  userId         String
  at             DateTime      @default(now())
  outcome        SignInOutcome

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId, at])
  @@index([userId, at])
}
