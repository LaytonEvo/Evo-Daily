# Copy to .env.test to run the database-backed test suites.
#
# WARNING: the integration suites truncate every table between tests. Point
# this at a throwaway database, never at anything holding real data.
#
# Leave it unset and those suites skip rather than fail, so the pure recurrence
# and timezone tests still run anywhere.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evotasks_test"
